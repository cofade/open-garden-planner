              }
            ],
            "license": "CC-BY-SA-4.0",
            "attribution": "Colaboradores de Open Garden Planner; contexto de cultivo de Cornell Cooperative Extension, en reconocimiento de la tradici\u00f3n ind\u00edgena de las tres hermanas.",
            "sources": [
              "https://warren.cce.cornell.edu/gardening-landscape/warren-county-master-gardener-articles/creating-a-three-sisters-garden"
            ],
            "name_de": "Drei-Schwestern-Beet",
            "description_de": "Mais, kletternde Feuerbohnen und Winterk\u00fcrbis. Standfeste Maissorten w\u00e4hlen und zeitlich versetzt s\u00e4en. Stickstofffixierung versorgt Nachbarpflanzen nicht sofort; Pflanzenreste setzen Stickstoff sp\u00e4ter frei."
          }
        }
